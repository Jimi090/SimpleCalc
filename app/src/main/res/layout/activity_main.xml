<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="horizontal"
    android:background="@color/black"
    >
    <Button
        android:id="@+id/history"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:textSize="20sp"
        android:background="@drawable/clock_circle_svgrepo_com"
        android:layout_marginStart="36dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <View
        android:id="@+id/spaceTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/history"
        app:layout_constraintBottom_toTopOf="@id/equationBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.1"/>
    <TextView
        android:id="@+id/equationBox"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:textSize="24sp"
        android:textColor="@color/lightGrey"
        android:layout_marginHorizontal="36dp"
        app:layout_constraintTop_toBottomOf="@id/spaceTop"
        app:layout_constraintEnd_toEndOf="parent" />


    <HorizontalScrollView
        android:id="@+id/textContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="horizontal"
        android:layout_marginHorizontal="36dp"
        app:layout_constraintTop_toBottomOf="@id/equationBox"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/textField"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:layout_gravity="end"
            android:singleLine="true"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="56sp" />
    </HorizontalScrollView>

    <GridLayout
        android:id="@+id/grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="4"
        android:rowCount="5"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="48dp"
        android:paddingHorizontal="0dp"
        app:layout_constraintTop_toBottomOf="@id/textContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/spaceBottom"
        app:layout_constraintDimensionRatio="5:6"
        android:useDefaultMargins="true">
            <Button
                android:id="@+id/delete"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"
                android:layout_margin="3dp"
                android:gravity="center"
                android:text="\u2421"
                android:textSize="40sp"
                />
            <Button
                android:id="@+id/clear"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="C"
                android:textSize="40sp" />
            <Button
                android:id="@+id/precent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="\u0025"
                android:textSize="40sp" />
            <Button
                android:id="@+id/division"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="\u00f7"
                android:textSize="40sp"
                android:backgroundTint="@color/orange"/>
        <!--################################-->

            <Button
                android:id="@+id/seven"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="7"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>

            <Button
                android:id="@+id/eight"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="8"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>

            <Button
                android:id="@+id/nine"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="9"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>
            <Button
                android:id="@+id/multiply"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="\u00d7"
                android:textSize="40sp"
                android:backgroundTint="@color/orange"/>
            <!--################################-->
            <Button
                android:id="@+id/four"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="4"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>

            <Button
                android:id="@+id/five"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="5"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>

            <Button
                android:id="@+id/six"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="6"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>
            <Button
                android:id="@+id/minus"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="\u2212"
                android:textSize="40sp"
                android:backgroundTint="@color/orange"/>
            <!--################################-->
            <Button
                android:id="@+id/one"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="1"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>

            <Button
                android:id="@+id/two"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"
                android:layout_margin="3dp"
                android:gravity="center"

                android:text="2"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>

            <Button
                android:id="@+id/three"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="3"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>
            <Button
                android:id="@+id/plus"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="\u002b"
                android:textSize="40sp"
                android:backgroundTint="@color/orange"/>
            <!--################################-->
            <Button
                android:id="@+id/signChange"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="\u00b1"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>
            <Button
                android:id="@+id/zero"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="0"
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>

            <Button
                android:id="@+id/point"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="."
                android:textSize="40sp"
                android:backgroundTint="@color/grey"/>

            <Button
                android:id="@+id/equal"
                                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:padding="0dp"

                android:layout_margin="3dp"
                android:gravity="center"
                android:text="="
                android:textSize="40sp"
                android:backgroundTint="@color/orange"/>
    </GridLayout>
    <View
        android:id="@+id/spaceBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/grid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.001"/>

</androidx.constraintlayout.widget.ConstraintLayout>